#!/usr/bin/env bash
#MISE description="Restore SQLite DB from backup (requires --yes --stopped)"
set -euo pipefail

usage() {
  echo "usage: mise run db:restore -- --yes --stopped <backup-file>" >&2
}

if [[ $# -ne 3 || "$1" != "--yes" || "$2" != "--stopped" ]]; then
  echo "refusing restore without --yes and --stopped confirmation" >&2
  usage
  exit 1
fi

backup_file="$3"

if [[ ! -f "$backup_file" ]]; then
  echo "backup file not found: $backup_file" >&2
  exit 1
fi

db_path="${CUBBY_DB_PATH:-./data/cubby.db}"
mkdir -p "$(dirname "$db_path")"

sqlite3 "$backup_file" \
  ".backup '$db_path'"
